<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Online Career Survey</title>

<style>

/* =========================
GENERAL STYLE
========================= */

body{
margin:0;
font-family:Arial, Helvetica, sans-serif;
background:#0d1117;
color:white;
}

.container{
width:90%;
max-width:1000px;
margin:auto;
text-align:center;
}

h1{
font-size:40px;
margin-top:40px;
}

h2{
font-size:28px;
margin-top:30px;
}

p{
font-size:18px;
line-height:1.6;
}

.btn{
display:inline-block;
background:#00ff88;
color:black;
padding:15px 30px;
font-size:20px;
font-weight:bold;
border-radius:8px;
text-decoration:none;
margin-top:20px;
transition:0.3s;
}

.btn:hover{
background:#00cc6a;
}

/* =========================
HEADER
========================= */

header{
background:#161b22;
padding:40px 20px;
border-bottom:1px solid #30363d;
}

.logo{
font-size:28px;
font-weight:bold;
color:#00ff88;
}

/* =========================
TIMER
========================= */

.timer{
font-size:30px;
margin-top:20px;
color:#ffcc00;
}

/* =========================
CARD SECTION
========================= */

.card{
background:#161b22;
padding:30px;
border-radius:10px;
margin-top:30px;
box-shadow:0 0 20px rgba(0,0,0,0.4);
}

/* =========================
STEPS
========================= */

.steps{
display:grid;
grid-template-columns:repeat(auto-fit,minmax(250px,1fr));
gap:20px;
margin-top:30px;
}

.step{
background:#1f242c;
padding:20px;
border-radius:10px;
}

/* =========================
REVIEWS
========================= */

.reviews{
margin-top:50px;
}

.review{
background:#1f242c;
padding:20px;
border-radius:10px;
margin-top:15px;
}

/* =========================
FAQ
========================= */

.faq{
margin-top:40px;
text-align:left;
}

.faq-item{
background:#1f242c;
margin-top:10px;
padding:15px;
border-radius:8px;
}

/* =========================
FOOTER
========================= */

footer{
margin-top:50px;
padding:20px;
background:#161b22;
font-size:14px;
color:#888;
}

/* =========================
ANIMATION
========================= */

@keyframes pulse{
0%{transform:scale(1);}
50%{transform:scale(1.05);}
100%{transform:scale(1);}
}

.pulse{
animation:pulse 2s infinite;
}

</style>

</head>

<body>

<header>

<div class="container">

<div class="logo">ONLINE SURVEY REWARD</div>

<h1>Make Money From Simple Survey</h1>

<p>Answer a few questions and discover how people earn money online.</p>

<div class="timer" id="timer">05:00</div>

<a href="https://singingfiles.com/show.php?l=0&u=685837&id=54747" class="btn pulse">START SURVEY</a>

</div>

</header>


<section class="container">

<div class="card">

<h2>How It Works</h2>

<div class="steps">

<div class="step">
<h3>Step 1</h3>
<p>Click the start survey button.</p>
</div>

<div class="step">
<h3>Step 2</h3>
<p>Answer a few simple questions.</p>
</div>

<div class="step">
<h3>Step 3</h3>
<p>Submit your email to see results.</p>
</div>

</div>

</div>

</section>


<section class="container reviews">

<h2>User Reviews</h2>

<div class="review">
⭐⭐⭐⭐⭐  
<p>This survey helped me learn about online earning.</p>
</div>

<div class="review">
⭐⭐⭐⭐⭐  
<p>Very easy questions. Took only 2 minutes.</p>
</div>

<div class="review">
⭐⭐⭐⭐⭐  
<p>I recommend everyone to try this survey.</p>
</div>

</section>


<section class="container faq">

<h2>Frequently Asked Questions</h2>

<div class="faq-item">
<strong>Is this survey free?</strong>
<p>Yes, it is completely free to participate.</p>
</div>

<div class="faq-item">
<strong>How long does it take?</strong>
<p>Usually less than 2 minutes.</p>
</div>

<div class="faq-item">
<strong>Who can participate?</strong>
<p>Anyone from supported countries.</p>
</div>

</section>


<footer>

<p>© 2025 Online Survey Program</p>

</footer>


<script>

/* =========================
COUNTDOWN TIMER
========================= */

let time = 300;

function updateTimer(){

let minutes = Math.floor(time / 60);
let seconds = time % 60;

seconds = seconds < 10 ? "0" + seconds : seconds;

document.getElementById("timer").innerHTML =
minutes + ":" + seconds;

if(time > 0){
time--;
}

}

setInterval(updateTimer,1000);

</script>


</body>
</html>
